  m_Script: {fileID: 11500000, guid: b030f8ae0b9d0a14b9236404aa1377dd, type: 3}
  m_Name: Question_Lvl_02
  m_EditorClassIdentifier: Assembly-CSharp::QuestionData
  questionText: "Warum f\xFChrt die von der Fahrradfahrerin ausge\xFCbte Kraft dazu,
    dass sie mal schneller und mal langsamer wird?"
  answers:
  - answerText: Weil die Kraft die Beschleunigung des Fahrrads bewirkt
    explanation: "Super! Die Kraft f\xFChrt zu einer Ver\xE4nderung der Bewegung
      (Beschleunigung) und sorgt dadurch daf\xFCr, dass das Fahrrad schneller oder
      langsamer wird."
  - answerText: "Weil die Kraft die Tr\xE4gheit des Fahrrads \xFCberwinden l\xE4sst"
    explanation: "Die Tr\xE4gheit spielt hier keine Rolle, da die Fahrradfahrerin
      selbst den Bewegungszustand steuert, nicht das Fahrrad an sich."
  - answerText: "Weil die Kraft die Geschwindigkeit des Fahrrads erh\xF6ht"
    explanation: "Die Geschwindigkeit ist ein Zustand, keine Ver\xE4nderung. Daher
      kann sie nicht direkt erkl\xE4ren, warum das Fahrrad schneller oder langsamer
      wird."
  correctAnswerIndex: 0
  correctFeedback: Richtig! Gut gemacht!
  wrongFeedback: Leider falsch. Versuch es nochmal!
  basePoints: 100
