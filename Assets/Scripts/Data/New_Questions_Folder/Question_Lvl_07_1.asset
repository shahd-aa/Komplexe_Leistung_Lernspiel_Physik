  m_EditorClassIdentifier: Assembly-CSharp::QuestionData
  questionText: "Wie gro\xDF ist die gesamte Kraft auf der Kiste?"
  answers:
  - answerText: 5N
    explanation: "Da die beide Kr\xE4fte in dieselbe Richtung zeigen, m\xFCssen sie
      addiert und nicht subtrahiert werden!"
  - answerText: 25N
    explanation: "Die Kiste erf\xE4hrt zwei Kr\xE4fte mit unterschiedlichen Betr\xE4gen,
      also m\xFCssen sie je nach Richtung entweder addiert oder subtrahiert werden!"
  - answerText: 55N
    explanation: "Genau! Da beide Kr\xE4fte in dieselbe Richtung zeigen, addieren
      sie sich."
  - answerText: 30N
    explanation: "Die Kiste erf\xE4hrt zwei Kr\xE4fte mit unterschiedlichen Betr\xE4gen,
      also m\xFCssen sie je nach Richtung entweder addiert oder subtrahiert werden!"
  correctAnswerIndex: 2
  correctFeedback: Richtig! Gut gemacht!
  wrongFeedback: Leider falsch. Versuch es nochmal!
