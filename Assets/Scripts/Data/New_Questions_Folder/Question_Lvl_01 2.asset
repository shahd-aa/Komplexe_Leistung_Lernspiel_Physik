  m_Script: {fileID: 11500000, guid: b030f8ae0b9d0a14b9236404aa1377dd, type: 3}
  m_Name: Question_Lvl_01 2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionData
  questionText: Warum rutschen die Kisten nach vorne, obwohl das Auto abbiegt?
  answers:
  - answerText: Weil die Kisten von der Kraft des Autos nichts erfahren
    explanation: "Genau! Die Kisten sind unbefestigt und k\xF6nnen deswegen ihren
      Bewegungszustand nicht wie das Auto \xE4ndern. Sie behalten stattdessen ihre
      geradlinige Bewegung bei."
  - answerText: Weil das Auto eine schnelle Geschwindigkeit hat
    explanation: "Wenn die Geschwindigkeit der Grund w\xE4re, w\xFCrden die Kisten
      bereits beim Losfahren wegrutschen. In dieser Situation ist das aber nicht
      der Fall."
  - answerText: Weil die Kisten eine geringe Masse haben
    explanation: "Wenn die Masse der Grund w\xE4re, w\xFCrden schwere Kisten nicht
      rutschen. Die Masse eines Objekts bestimmt jedoch nicht, ob es rutscht oder
      nicht."
  correctAnswerIndex: 0
  correctFeedback: Richtig! Gut gemacht!
  wrongFeedback: Leider falsch. Versuch es nochmal!
  basePoints: 100
