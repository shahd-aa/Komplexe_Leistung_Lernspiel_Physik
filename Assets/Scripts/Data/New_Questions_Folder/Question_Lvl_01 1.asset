  m_Script: {fileID: 11500000, guid: b030f8ae0b9d0a14b9236404aa1377dd, type: 3}
  m_Name: Question_Lvl_01 1
  m_EditorClassIdentifier: Assembly-CSharp::QuestionData
  questionText: Welches Gesetz wird in dieser Situation demonstriert?
  answers:
  - answerText: "erstes Newtonsches Gesetz: Tr\xE4gheitsprinzip"
    explanation: "Genau! Hier wird das Tr\xE4gheitsgesetz veranschaulicht. Es besagt,
      dass ein K\xF6rper seinen Bewegungszustand beibehalten m\xF6chte, solange keine
      \xE4u\xDFere Kraft ihn \xE4ndert."
  - answerText: 'zweites Newtonsches Gesetz: Aktionsprinzip'
    explanation: "Das Aktionsprinzip beschreibt den Zusammenhang zwischen Masse,
      Beschleunigung und Kraft. In dieser Situation geht es jedoch nicht um den Zusammenhang
      dieser Gr\xF6\xDFen."
  - answerText: 'drittes Newtonsches Gesetz: Wechselwirkungsprinzip'
    explanation: "Das Wechselwirkungsprinzip tritt auf, wenn zwei verschiedene K\xF6rper
      miteinander in Kontakt treten und Kr\xE4fte aufeinander aus\xFCben. In dieser
      Situation sind aber keine zwei K\xF6rper beteiligt, die sich gegenseitig beeinflussen."
  correctAnswerIndex: 0
  correctFeedback: Richtig! Gut gemacht!
  wrongFeedback: Leider falsch. Versuch es nochmal!
  basePoints: 100
