  m_Script: {fileID: 11500000, guid: b030f8ae0b9d0a14b9236404aa1377dd, type: 3}
  m_Name: Question_Lvl_03
  m_EditorClassIdentifier: Assembly-CSharp::QuestionData
  questionText: Welche Kraft wirkt auf den Ball, wenn er auf den Boden trifft?
  answers:
  - answerText: Erdanziehungskraft
    explanation: "Fast! Die Erdanziehungskraft beschleunigt den Ball nach unten,
      aber sie ist nicht die Kraft, die ihn aufh\xE4lt."
  - answerText: Gegenkraft des Bodens
    explanation: "Ja! Der Boden \xFCbt beim Aufprall eine nach oben gerichtete Gegenkraft
      aus und beschleunigt den Ball deswegen wieder nach oben."
  - answerText: Spannkraft des Balls
    explanation: Die Spannkraft entsteht durch die Verformung des Balls, ist aber
      nicht die Kraft, die beim Aufprall auf ihn wirkt.
  - answerText: Gewichtskraft des Balls
    explanation: "Die Gewichtskraft wirkt senkrecht zum Boden und kann daher nicht
      die Kraft sein, die den Ball beim Auftreffen stoppt, sonst w\xFCrde er weiter
      nach unten sinken."
  correctAnswerIndex: 1
  correctFeedback: Richtig! Gut gemacht!
  wrongFeedback: Leider falsch. Versuch es nochmal!
  basePoints: 100
